{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "menu-pic",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    "DEFAULT_OPENAI_MODEL": "gpt-5.6-luna",
    "ALLOWED_OPENAI_MODELS": "gpt-5.6-luna,gpt-5.4-mini,gpt-4o-mini",
    "ALLOWED_ORIGINS": "https://toshio613.github.io,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5517,http://127.0.0.1:5517,http://localhost:8787",
    "MAX_IMAGE_BYTES": "1572864",
    "AUTH_TOKEN_TTL_SECONDS": "604800"
  },
  "secrets": {
    "required": ["OPENAI_API_KEY", "FAMILY_PASSWORD", "TOKEN_SECRET"]
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "menu-pic-recipes",
      "migrations_dir": "migrations"
    }
  ]
}
